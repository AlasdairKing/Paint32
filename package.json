{
  "name": "paint32",
  "version": "1.0.0",
  "description": "A simple graphics program in HTML/JS",
  "main": "index.html",
  "scripts": {
    "start": "serve src -l 5173",
    "dev": "npm start",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint src/paint.js src/service-worker.js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "htmlhint src/index.html",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "npm run lint && npm run format:check",
    "test": "npm run check"
  },
  "author": "Alasdair King",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.1.4",
    "prettier": "3.4.2",
    "serve": "^14.2.4",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
